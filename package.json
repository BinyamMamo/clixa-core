{
  "name": "clixa-core",
  "version": "0.1.2",
  "description": "Clinical calculation engine: 63 calculators, medical scores and AJCC/FIGO staging, with Ethiopian calendar support. Pure TypeScript, no DOM, no dependencies.",
  "license": "UNLICENSED",
  "author": "Clixa Health",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BinyamMamo/clixa-core.git"
  },
  "homepage": "https://clixa-tools.vercel.app",
  "bugs": {
    "url": "https://github.com/BinyamMamo/clixa-core/issues"
  },
  "keywords": [
    "clinical",
    "calculator",
    "medical",
    "ethiopia",
    "tnm",
    "who-growth-standards"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./who": {
      "types": "./dist/who/zscore.d.ts",
      "import": "./dist/who/zscore.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "golden:capture": "node golden/capture.mjs",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18"
  }
}
